[Unit]
Description=Binance Futures AI Trading Assistant (Telegram alerts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/trading-assistant
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=10
Environment=NODE_ENV=production
# Load secrets from the project .env (do not commit this file)
EnvironmentFile=-/opt/trading-assistant/.env

# Harden a bit
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
