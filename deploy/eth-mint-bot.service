[Unit]
Description=ETH free + private mint Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change these two paths if you cloned elsewhere / different Linux user
User=ubuntu
WorkingDirectory=/home/ubuntu/telegram-bot
Environment=NODE_ENV=production
# Loads .env via dotenv inside the app — keep secrets ONLY in WorkingDirectory/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
# Limit crash loops filling disk
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
