[Unit]
Description=@porshmints_bot Ethereum free + private mint Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# IMPORTANT: keep this bot in its OWN folder — do not reuse the @Nftcopymint_bot (Robinhood) directory.
User=root
WorkingDirectory=/root/porshmints-bot
Environment=NODE_ENV=production
# Loads .env via dotenv inside the app — keep secrets ONLY in WorkingDirectory/.env
# Use a DIFFERENT TELEGRAM_BOT_TOKEN than @Nftcopymint_bot
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
