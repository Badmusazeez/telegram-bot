[Unit]
Description=@porshmints_bot Ink free + private mint Telegram bot (NOT @Nftcopymint_bot / Robinhood)
After=network-online.target
Wants=network-online.target
# Separate unit name from any Robinhood bot service — do not Conflict/replace it.

[Service]
Type=simple
# REQUIRED: own folder. Never point this at the Robinhood / telegram-bot directory.
User=root
WorkingDirectory=/root/porshmints-bot
Environment=NODE_ENV=production
Environment=CHAIN=ink
# Secrets live ONLY in WorkingDirectory/.env
# TELEGRAM_BOT_TOKEN must be @porshmints_bot — never @Nftcopymint_bot
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
