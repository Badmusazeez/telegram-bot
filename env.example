# Telegram — create a bot with @BotFather, then get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Robinhood Chain (mainnet chainId 4663)
CHAIN=robinhood
# Track = Alchemy | Mint = Chainstack
TRACK_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/alch_6wCXrJ4PI_ruR2IwyQSM2
MINT_RPC_URL=https://robinhood-mainnet.core.chainstack.com/c41397d693c1e6321dfafd4eeede62f0
ALCHEMY_API_KEY=alch_6wCXrJ4PI_ruR2IwyQSM2
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/alch_6wCXrJ4PI_ruR2IwyQSM2
TRACK_RPC_BACKUP_URL=
MINT_RPC_BACKUP_URL=

# Free-mint auto copy
FREE_MINTS_ONLY=true
COPY_ENABLED=false
DRY_RUN=true

# Buyer wallet private key(s) — Robinhood Chain gas required on each wallet
PRIVATE_KEY=
# Optional: extra mint wallets as comma-separated private keys
# PRIVATE_KEYS=0xabc...,0xdef...
# Or add at runtime via Telegram: /addkey <private_key>
# Keys added via Telegram are stored in data/mint-wallets.json (never commit that file)

MAX_BUY_ROBINHOOD=0.05
MAX_GAS_GWEI=40
MAX_MINT_GAS_LIMIT=1500000
MAX_MINT_QUANTITY=100
POLL_INTERVAL_MS=
LOOKBACK_BLOCKS=

ALLOWED_COLLECTIONS=
# Optional — bot auto-creates a 7-day free key via:
#   curl -X POST https://api.opensea.io/api/v2/auth/keys
OPENSEA_API_KEY=ad4043b349e3405b89c00ad70976263b

PRICE_ALERTS_ENABLED=true
PRICE_ALERT_PCT=10
PRICE_POLL_INTERVAL_MS=120000
