# Telegram — create a bot with @BotFather, then get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Robinhood Chain
CHAIN=robinhood
# Primary tracker (Chainstack) — whale monitoring
TRACK_RPC_URL=https://robinhood-mainnet.core.chainstack.com/YOUR_CHAINSTACK_KEY
# Backup tracker (Alchemy) — used automatically if primary is slow/down
TRACK_RPC_BACKUP_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Legacy alias for TRACK_RPC_URL (still supported)
ROBINHOOD_RPC_URL=https://robinhood-mainnet.core.chainstack.com/YOUR_CHAINSTACK_KEY
ALCHEMY_API_KEY=YOUR_ALCHEMY_KEY
# Mint RPC (send txs) — Chainstack recommended
MINT_RPC_URL=https://robinhood-mainnet.core.chainstack.com/YOUR_CHAINSTACK_KEY

# Free-mint auto copy
FREE_MINTS_ONLY=true
COPY_ENABLED=false
DRY_RUN=true

# Buyer wallet private key(s) — Robinhood Chain gas required on each wallet
PRIVATE_KEY=
# Optional: extra mint wallets as comma-separated private keys
# PRIVATE_KEYS=0xabc...,0xdef...
# Or add at runtime via Telegram: /addkey <private_key>
# Keys added via Telegram are stored in data/mint-wallets.json (never commit that file)

MAX_BUY_ROBINHOOD=0.05
MAX_GAS_GWEI=40
MAX_MINT_GAS_LIMIT=500000
POLL_INTERVAL_MS=
LOOKBACK_BLOCKS=

ALLOWED_COLLECTIONS=
# Optional — bot auto-creates a 7-day free key via:
#   curl -X POST https://api.opensea.io/api/v2/auth/keys
# Set a permanent key here to override auto-fetch.
OPENSEA_API_KEY=

# Price alerts for minted NFTs / collection floors (OpenSea API key)
PRICE_ALERTS_ENABLED=true
PRICE_ALERT_PCT=10
PRICE_POLL_INTERVAL_MS=120000
