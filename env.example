# @porshmints_bot — Ink chain ONLY
# Entirely separate from @Nftcopymint_bot (Robinhood).
# Do NOT reuse that bot's token, folder, .env, keys, or data files.
# VPS path must be ~/porshmints-bot — never ~/telegram-bot.

# Telegram — create a SEPARATE bot with @BotFather for @porshmints_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Ink mainnet (Kraken OP Stack L2) — never set robinhood / ethereum here
CHAIN=ink
# Public RPC (works without a key). For higher limits use Alchemy ink-mainnet.
ETH_RPC_URL=https://rpc-gel.inkonchain.com
# Optional aliases (any one is enough):
# INK_RPC_URL=https://rpc-gel.inkonchain.com
# RPC_URL=https://ink-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_API_KEY=

# Mint modes
# FREE_MINTS_ONLY=true  → only 0 ETH free mints
# FREE_MINTS_ONLY=false + PRIVATE_MINTS_ENABLED=true → free + private/paid mints under MAX_BUY_ETH
FREE_MINTS_ONLY=false
PRIVATE_MINTS_ENABLED=true
COPY_ENABLED=false
DRY_RUN=true

# Your Ink mint wallet private key(s) — ETH on Ink for gas (+ mint price for private mints)
PRIVATE_KEY=
# Optional: extra mint wallets as comma-separated private keys
# PRIVATE_KEYS=0xabc...,0xdef...
# Or add at runtime via Telegram: /addkey <private_key>
# Stored in data/porshmints-mint-wallets.json (never commit)

# Wallets to track on Ink (optional — or use /track in Telegram)
# Format: 0xWhale1,0xWhale2  or  0xWhale1:Label1,0xWhale2:Label2
TRACKED_WALLETS=

# Max ETH to spend on a private/paid mint copy (native gas token on Ink is ETH)
MAX_BUY_ETH=0.05
MAX_GAS_GWEI=50
MAX_MINT_GAS_LIMIT=500000
POLL_INTERVAL_MS=
LOOKBACK_BLOCKS=

ALLOWED_COLLECTIONS=
OPENSEA_API_KEY=

# Price alerts for minted NFTs / collection floors (needs OPENSEA_API_KEY)
PRICE_ALERTS_ENABLED=true
PRICE_ALERT_PCT=10
PRICE_POLL_INTERVAL_MS=120000
