# Arc NFT copy bot (do NOT mix with Robinhood bot env)

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# arc (mainnet, chainId 5042) | arc-testnet (5042002)
CHAIN=arc
# Public RPCs for now
TRACK_RPC_URL=https://rpc.arc-scan.org
MINT_RPC_URL=https://rpc.arc-scan.org
# TRACK_RPC_BACKUP_URL=
# MINT_RPC_BACKUP_URL=

# Testnet alternative:
# CHAIN=arc-testnet
# TRACK_RPC_URL=https://rpc.testnet.arc.io
# MINT_RPC_URL=https://rpc.testnet.arc.io

COPY_ENABLED=false
DRY_RUN=true
FREE_MINTS_ONLY=true

PRIVATE_KEY=
# PRIVATE_KEYS=0xabc...,0xdef...
# FUNDING_PRIVATE_KEY=

MAX_BUY_ROBINHOOD=0.05
MAX_GAS_GWEI=100
MAX_MINT_GAS_LIMIT=2500000
MAX_MINT_QUANTITY=100

PRICE_ALERTS_ENABLED=true
PRICE_ALERT_PCT=10
