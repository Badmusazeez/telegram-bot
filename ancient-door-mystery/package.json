{
  "name": "ancient-door-mystery",
  "version": "1.0.0",
  "description": "Ancient Door Mystery — Telegram story bot with cinematic Pidgin dialogue",
  "main": "dist/index.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/check-env.mjs",
    "bot": "node scripts/run.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "web": "python3 -m http.server 5173",
    "video": "node scripts/generate-video.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
