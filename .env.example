# Copy to .env. Never commit .env.
# Ethereum mainnet — Alchemy for track + mint. Separate from RH/Arc/Ink.

TELEGRAM_BOT_TOKEN=   # @LarEth_Bot
TELEGRAM_ALLOWED_CHAT_IDS=543570208

CHAIN=ethereum
TRACK_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
MINT_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_API_KEY=

COPY_ENABLED=false
DRY_RUN=true
FREE_MINTS_ONLY=true

PRIVATE_KEY=
PRIVATE_KEYS=

MAX_BUY_ROBINHOOD=0.05
MAX_GAS_GWEI=100
MAX_MINT_GAS_LIMIT=2500000
MAX_MINT_QUANTITY=100

PRICE_ALERTS_ENABLED=true
PRICE_ALERT_PCT=10
