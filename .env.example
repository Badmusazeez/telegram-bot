# Telegram — create a bot with @BotFather, then get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Ethereum mainnet
CHAIN=ethereum
# Recommended: Alchemy ETH mainnet RPC
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_API_KEY=YOUR_KEY

# Mint modes
# FREE_MINTS_ONLY=true  → only 0 ETH free mints
# FREE_MINTS_ONLY=false + PRIVATE_MINTS_ENABLED=true → free + private/paid mints under MAX_BUY_ETH
FREE_MINTS_ONLY=false
PRIVATE_MINTS_ENABLED=true
COPY_ENABLED=false
DRY_RUN=true

# Your mint wallet private key(s)
PRIVATE_KEY=
# Optional: comma-separated extra mint wallets
# PRIVATE_KEYS=0xabc...,0xdef...
# Or add at runtime via Telegram: /addkey <private_key>
# Keys from Telegram are stored in data/mint-wallets.json (do not commit)

# Wallets to track (optional — or use /track in Telegram)
# Format: 0xWhale1,0xWhale2  or  0xWhale1:Label1,0xWhale2:Label2
TRACKED_WALLETS=

# Max ETH to spend on a private/paid mint copy
MAX_BUY_ETH=0.05
MAX_GAS_GWEI=50
MAX_MINT_GAS_LIMIT=500000
POLL_INTERVAL_MS=
LOOKBACK_BLOCKS=

ALLOWED_COLLECTIONS=
OPENSEA_API_KEY=

# Price alerts for minted NFTs / collection floors (needs OPENSEA_API_KEY)
PRICE_ALERTS_ENABLED=true
PRICE_ALERT_PCT=10
PRICE_POLL_INTERVAL_MS=120000
