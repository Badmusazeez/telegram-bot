# Telegram — create a bot with @BotFather, then get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Robinhood Chain
CHAIN=robinhood
# Tracker RPC (whale monitoring / eth_getLogs) — Alchemy
TRACK_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_API_KEY=YOUR_ALCHEMY_KEY
# Mint RPC (send txs) — Chainstack
MINT_RPC_URL=https://robinhood-mainnet.core.chainstack.com/YOUR_CHAINSTACK_KEY

# Free-mint auto copy
FREE_MINTS_ONLY=true
COPY_ENABLED=false
DRY_RUN=true

# Buyer wallet private key(s) — Robinhood Chain gas required on each wallet
PRIVATE_KEY=
# Optional: comma-separated extra mint wallets
# PRIVATE_KEYS=0xabc...,0xdef...
# Or add at runtime via Telegram: /addkey <private_key>
# Keys from Telegram are stored in data/mint-wallets.json (do not commit)

MAX_BUY_ROBINHOOD=0.05
MAX_GAS_GWEI=40
MAX_MINT_GAS_LIMIT=500000
POLL_INTERVAL_MS=
LOOKBACK_BLOCKS=

ALLOWED_COLLECTIONS=
# Required for price alerts + /schedulemint <opensea-url> auto time
OPENSEA_API_KEY=

# Price alerts for minted NFTs / collection floors (needs OPENSEA_API_KEY)
PRICE_ALERTS_ENABLED=true
PRICE_ALERT_PCT=10
PRICE_POLL_INTERVAL_MS=120000
