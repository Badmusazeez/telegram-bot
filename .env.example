# @porshmints_bot — Ethereum ONLY
# Do NOT reuse @Nftcopymint_bot (Robinhood) token, .env, keys, or data files.

# Telegram — create a SEPARATE bot with @BotFather for @porshmints_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Ethereum mainnet
CHAIN=ethereum
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_API_KEY=YOUR_KEY

# Mint modes
FREE_MINTS_ONLY=false
PRIVATE_MINTS_ENABLED=true
COPY_ENABLED=false
DRY_RUN=true

# Your Ethereum mint wallet private key(s)
PRIVATE_KEY=
# PRIVATE_KEYS=0xabc...,0xdef...

# Wallets to track on Ethereum
# Format: 0xWhale1,0xWhale2  or  0xWhale1:Label1,0xWhale2:Label2
TRACKED_WALLETS=

MAX_BUY_ETH=0.05
MAX_GAS_GWEI=50
MAX_MINT_GAS_LIMIT=500000
POLL_INTERVAL_MS=
LOOKBACK_BLOCKS=

ALLOWED_COLLECTIONS=
OPENSEA_API_KEY=

PRICE_ALERTS_ENABLED=true
PRICE_ALERT_PCT=10
PRICE_POLL_INTERVAL_MS=120000
