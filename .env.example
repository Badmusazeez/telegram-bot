# Telegram — create a bot with @BotFather, then get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Robinhood Chain
CHAIN=robinhood
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional Alchemy key
ALCHEMY_API_KEY=

# Free-mint auto copy
# FREE_MINTS_ONLY=true  -> only free mints (skip paid)
# COPY_ENABLED=true     -> attempt auto-mint when whale free-mints
# DRY_RUN=true          -> simulate only (recommended first)
FREE_MINTS_ONLY=true
COPY_ENABLED=false
DRY_RUN=true

# Your NEW buyer wallet private key (only when ready for live auto-mint)
# Fund this wallet with a little native gas on Robinhood Chain
PRIVATE_KEY=

MAX_BUY_ROBINHOOD=0.05
MAX_GAS_GWEI=40
MAX_MINT_GAS_LIMIT=500000
POLL_INTERVAL_MS=
LOOKBACK_BLOCKS=

# Optional allowlist of NFT contracts. Empty = any free mint.
ALLOWED_COLLECTIONS=

OPENSEA_API_KEY=
