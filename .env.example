# Telegram — create a bot with @BotFather, then get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Chain: ethereum | robinhood
CHAIN=robinhood

# RPC
# Robinhood Chain public RPC (default when CHAIN=robinhood):
ETH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Ethereum mainnet example:
# CHAIN=ethereum
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: Alchemy API key (Ethereum NFT metadata enrichment)
ALCHEMY_API_KEY=

# Copy trading (keep dry-run on until you understand the risks)
COPY_ENABLED=false
DRY_RUN=true
PRIVATE_KEY=
MAX_BUY_ETH=0.05
MAX_GAS_GWEI=40
# Leave blank to use chain defaults (Robinhood uses faster polling)
POLL_INTERVAL_MS=
LOOKBACK_BLOCKS=

# Optional: only copy these collections (comma-separated contract addresses). Empty = any.
ALLOWED_COLLECTIONS=

# Optional: OpenSea API key for listing lookups when copying
OPENSEA_API_KEY=
