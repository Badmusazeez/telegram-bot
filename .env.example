# Telegram — create a bot with @BotFather, then get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Robinhood Chain
CHAIN=robinhood
# Primary tracker — Alchemy TESTNET
TRACK_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/eVuaN-ufVXjtvufzC9Tiu
# Mint — Alchemy MAINNET (keep same network as the chain you mint on)
MINT_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/eVuaN-ufVXjtvufzC9Tiu
ALCHEMY_API_KEY=eVuaN-ufVXjtvufzC9Tiu
# Backup tracker — Chainstack (auto failover when Alchemy is slow/down)
TRACK_RPC_BACKUP_URL=https://robinhood-mainnet.core.chainstack.com/YOUR_CHAINSTACK_KEY
# Optional mint backup (defaults to TRACK_RPC_BACKUP_URL if set)
MINT_RPC_BACKUP_URL=https://robinhood-mainnet.core.chainstack.com/YOUR_CHAINSTACK_KEY
# Legacy alias for TRACK_RPC_URL (still supported)
ROBINHOOD_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/eVuaN-ufVXjtvufzC9Tiu

# Free-mint auto copy
FREE_MINTS_ONLY=true
COPY_ENABLED=false
DRY_RUN=true

# Buyer wallet private key(s) — Robinhood Chain gas required on each wallet
PRIVATE_KEY=
# Optional: comma-separated extra mint wallets
# PRIVATE_KEYS=0xabc...,0xdef...
# Or add at runtime via Telegram: /addkey <private_key>
# Keys from Telegram are stored in data/mint-wallets.json (do not commit)

MAX_BUY_ROBINHOOD=0.05
MAX_GAS_GWEI=40
MAX_MINT_GAS_LIMIT=1500000
MAX_MINT_QUANTITY=50
POLL_INTERVAL_MS=
LOOKBACK_BLOCKS=

ALLOWED_COLLECTIONS=
# Optional — bot auto-creates a 7-day free key via:
#   curl -X POST https://api.opensea.io/api/v2/auth/keys
# Set a permanent key here to override auto-fetch.
OPENSEA_API_KEY=

# Price alerts for minted NFTs / collection floors (OpenSea API key)
PRICE_ALERTS_ENABLED=true
PRICE_ALERT_PCT=10
PRICE_POLL_INTERVAL_MS=120000
