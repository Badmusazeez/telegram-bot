# Telegram — create a bot with @BotFather, then get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Exchange: mexc (default) or binance
EXCHANGE=mexc
MEXC_FUTURES_BASE_URL=https://contract.mexc.com

# Binance Futures (only used when EXCHANGE=binance)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# Scanner
TIMEFRAME=15m
TREND_TIMEFRAME=1h
REQUIRE_TREND_ALIGNMENT=true
SCAN_INTERVAL_MS=60000
MIN_QUOTE_VOLUME_USDT=8000000
MAX_PAIRS=0
MAX_ALERTS_PER_SCAN=3
SYMBOL_WHITELIST=
SYMBOL_BLACKLIST=

# EMA crossover
EMA_FAST=9
EMA_SLOW=21

# Technical confirmations
REQUIRE_RSI=true
RSI_PERIOD=14
RSI_LONG_MIN=45
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=55
REQUIRE_MACD=true
REQUIRE_VOLUME=true
REQUIRE_VOLUME_SPIKE=true
VOLUME_MA_PERIOD=20
VOLUME_SPIKE_MULT=1.2
MIN_TECHNICAL_SCORE=3
MIN_CONFIDENCE=65
MIN_ATR_PCT=0.2
MAX_ATR_PCT=6

# Fundamental confirmations
REQUIRE_FUNDING=true
FUNDING_LONG_MAX=0.0005
FUNDING_SHORT_MIN=-0.0005
REQUIRE_OPEN_INTEREST=true
OI_LOOKBACK_PERIODS=6
MIN_FUNDAMENTAL_SCORE=1

# Risk / TP & SL (ATR-based)
ATR_PERIOD=14
STOP_LOSS_ATR_MULT=1.5
TAKE_PROFIT_ATR_MULT=3
TAKE_PROFIT_2_ATR_MULT=5

# Alert hygiene
SIGNAL_COOLDOWN_MS=3600000
DRY_RUN=false
ALERTS_ENABLED=true
