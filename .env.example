# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Exchange
EXCHANGE=mexc
MEXC_FUTURES_BASE_URL=https://contract.mexc.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# Scanner
TIMEFRAME=15m
TREND_TIMEFRAME=1h
REQUIRE_TREND_ALIGNMENT=true
# balanced mode defaults to 180s / 80 pairs if these are omitted
SCAN_INTERVAL_MS=180000
MIN_QUOTE_VOLUME_USDT=5000000
MAX_PAIRS=80
MAX_ALERTS_PER_SCAN=5
SYMBOL_WHITELIST=
SYMBOL_BLACKLIST=
LOG_NO_TRADE=false

# Institutional gates
# GATE_MODE applies a preset (historical audit: SMC was the hard blocker)
#   strict   = conf 85, vol 1.5×, RR 2.5, 40 pairs, all hard
#   balanced = conf 75, vol 1.3×, RR 2.0, 80 pairs, SMC soft ≥30%  ← recommended
#   relaxed  = conf 70, vol 1.2×, RR 1.8, 100 pairs, more soft gates
GATE_MODE=balanced
MIN_CONFIDENCE=75
MIN_RISK_REWARD=2.0
MAX_STOP_PCT=0.05
VOLUME_SPIKE_MULT=1.3
REQUIRE_VOLUME_SPIKE=true
MIN_TECHNICAL_SCORE=3
# Optional overrides (leave unset to use GATE_MODE preset):
# REQUIRE_SMC_HARD=false
# SMC_MIN_SCORE=0.3
# REQUIRE_PA_HARD=true
# REQUIRE_VOLUME_HARD=true
# REQUIRE_MOMENTUM_HARD=true

# Optional (unused in Telegram alerts — signals only)
ACCOUNT_BALANCE_USDT=1000
RISK_PERCENT=1

# Legacy / shared knobs
EMA_FAST=9
EMA_SLOW=21
REQUIRE_RSI=true
RSI_PERIOD=14
RSI_LONG_MIN=45
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=55
REQUIRE_MACD=true
REQUIRE_VOLUME=true
VOLUME_MA_PERIOD=20
MIN_ATR_PCT=0.2
MAX_ATR_PCT=6
REQUIRE_FUNDING=true
FUNDING_LONG_MAX=0.0005
FUNDING_SHORT_MIN=-0.0005
REQUIRE_OPEN_INTEREST=true
OI_LOOKBACK_PERIODS=6
MIN_FUNDAMENTAL_SCORE=1
ATR_PERIOD=14
STOP_LOSS_ATR_MULT=1.5
TAKE_PROFIT_ATR_MULT=3
TAKE_PROFIT_2_ATR_MULT=5
SIGNAL_COOLDOWN_MS=3600000
DRY_RUN=false
ALERTS_ENABLED=true
