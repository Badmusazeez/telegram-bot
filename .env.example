# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional MEXC credentials (public market data works without them)
MEXC_API_KEY=
MEXC_API_SECRET=

# Optional CoinMarketCap Pro API key (public CMC data-api used as fallback)
CMC_API_KEY=

# Runtime
CONFIG_PATH=config/settings.yaml
LOG_LEVEL=INFO
ACCOUNT_EQUITY=10000
DRY_RUN=false
