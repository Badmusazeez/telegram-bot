# Telegram — create a bot with @BotFather, then get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Robinhood Chain (mainnet chainId 4663)
CHAIN=robinhood
# Track = Alchemy | Mint = Chainstack
TRACK_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/alch_luJC1sI8LTivjAx3iet6D
MINT_RPC_URL=https://robinhood-mainnet.core.chainstack.com/461ed935f74d3a38394902fbbf61fb25
ALCHEMY_API_KEY=alch_luJC1sI8LTivjAx3iet6D
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/alch_luJC1sI8LTivjAx3iet6D
TRACK_RPC_BACKUP_URL=
MINT_RPC_BACKUP_URL=

# Optional — exact Alchemy CU % (NOT the alch_ app key)
# Dashboard → Security → Access Keys → enable Usage read
# ALCHEMY_ADMIN_KEY=
# ALCHEMY_MONTHLY_CU_LIMIT=30000000
# Chainstack: Platform API key → https://console.chainstack.com/user/settings/api-keys
# CHAINSTACK_API_KEY=
# CHAINSTACK_MONTHLY_RU_LIMIT=3000000
# RPC_QUOTA_INTERVAL_MS=21600000

# Free-mint auto copy
FREE_MINTS_ONLY=true
COPY_ENABLED=false
DRY_RUN=true

# Buyer wallet private key(s) — Robinhood Chain gas required on each wallet
PRIVATE_KEY=
# Optional: comma-separated extra mint wallets
# PRIVATE_KEYS=0xabc...,0xdef...
# Or add at runtime via Telegram: /addkey <private_key>
# Keys from Telegram are stored in data/mint-wallets.json (do not commit)

MAX_BUY_ROBINHOOD=0.05
MAX_GAS_GWEI=40
MAX_MINT_GAS_LIMIT=2500000
MAX_MINT_QUANTITY=100
POLL_INTERVAL_MS=
LOOKBACK_BLOCKS=

ALLOWED_COLLECTIONS=
# Optional — bot auto-creates a 7-day free key via:
#   curl -X POST https://api.opensea.io/api/v2/auth/keys
OPENSEA_API_KEY=ad4043b349e3405b89c00ad70976263b

PRICE_ALERTS_ENABLED=true
PRICE_ALERT_PCT=10
PRICE_POLL_INTERVAL_MS=120000
