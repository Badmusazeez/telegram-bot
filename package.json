{
  "name": "arc-nft-copy-bot",
  "version": "1.0.0",
  "description": "Arc Chain free-mint NFT copy bot with Telegram tracking (separate from Robinhood bot)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/robinhood/unwrittenPowWorker.cjs','dist/robinhood/unwrittenPowWorker.cjs')\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "import-keys": "tsx scripts/import-keys.ts",
    "import-tracks": "tsx scripts/import-tracks.ts",
    "opensea-key": "tsx scripts/fetch-opensea-key.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "arc",
    "circle-arc",
    "nft",
    "telegram",
    "copy-trading",
    "free-mint",
    "bot"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "grammy": "^1.35.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
