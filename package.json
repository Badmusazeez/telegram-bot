{
  "name": "robinhood-nft-copy-bot",
  "version": "1.0.0",
  "description": "Robinhood Chain free-mint NFT copy bot with Telegram tracking",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "opensea-key": "tsx scripts/fetch-opensea-key.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
